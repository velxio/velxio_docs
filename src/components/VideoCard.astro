---
/**
 * One video of the Velxio YouTube channel: its thumbnail, which plays in place
 * (YouTube's privacy-enhanced player, loaded on click only), its title and a
 * link to the gallery example it builds.
 *
 * Without JavaScript the thumbnail is a plain link to the video on YouTube.
 */
import { DOCS_LOCALES, localeKey, videoStrings } from "../data/video-strings";

export interface Video {
  id: string;
  kind: "long" | "short";
  lang: string;
  title: string;
  examples: string[];
  docs: string[];
  group: string;
}

interface Props {
  video: Video;
  lang: string;
  /** Docs pages to list under the card (the Videos page shows them). */
  showDocs?: boolean;
}

const { video, lang, showDocs = false } = Astro.props;
const s = videoStrings(lang);
const loc = localeKey(lang);
const prefix = DOCS_LOCALES.includes(loc) ? `/${loc}` : "";
const watch =
  video.kind === "short"
    ? `https://www.youtube.com/shorts/${video.id}`
    : `https://www.youtube.com/watch?v=${video.id}`;
const thumb = `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`;
const example = video.examples[0];
const sameLang = localeKey(video.lang) === loc;
const docsLinks = showDocs
  ? video.docs.map((p) => ({
      href: `/docs${prefix}/${p}/`,
      label: p.split("/").pop()!.replace(/-/g, " "),
    }))
  : [];
---

<figure class="vx-video" data-kind={video.kind}>
  <a
    class="vx-video-thumb"
    href={watch}
    target="_blank"
    rel="noopener noreferrer"
    data-yt={video.id}
    aria-label={`${s.play}: ${video.title}`}
  >
    <img src={thumb} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="vx-video-play" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"></path></svg>
    </span>
    <span class="vx-video-badges">
      {video.kind === "short" && <span class="vx-video-badge">{s.short}</span>}
      {!sameLang && <span class="vx-video-badge">{video.lang}</span>}
    </span>
  </a>
  <figcaption>
    <a class="vx-video-title" href={watch} target="_blank" rel="noopener noreferrer">{video.title}</a>
    {
      example && (
        <a class="vx-video-example" href={`${prefix}/example/${example}`}>
          {s.openExample}
        </a>
      )
    }
    {
      docsLinks.length > 0 && (
        <span class="vx-video-docs">
          {s.inDocs}:{" "}
          {docsLinks.map((d, i) => (
            <>
              {i > 0 && ", "}
              <a href={d.href}>{d.label}</a>
            </>
          ))}
        </span>
      )
    }
  </figcaption>
</figure>

<script>
  // Play in place: swap the thumbnail for the player on the first click.
  // Delegated, so it covers every card on the page with one listener.
  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>("a.vx-video-thumb[data-yt]");
    if (!a || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    const id = a.dataset.yt!;
    const frame = document.createElement("iframe");
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
    frame.title = a.getAttribute("aria-label") ?? "YouTube";
    frame.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    frame.allowFullscreen = true;
    const box = document.createElement("div");
    box.className = "vx-video-thumb is-playing";
    box.appendChild(frame);
    a.replaceWith(box);
  });
</script>

<style is:global>
  .vx-video {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .vx-video-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
  }
  .vx-video[data-kind="short"] .vx-video-thumb.is-playing {
    aspect-ratio: 9 / 16;
    max-height: 70vh;
    margin: 0 auto;
    width: auto;
  }
  .vx-video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
  }
  .vx-video-thumb iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .vx-video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 36px;
    transform: translate(-50%, -50%);
    border-radius: 9px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vx-video-thumb:hover .vx-video-play,
  .vx-video-thumb:focus-visible .vx-video-play {
    background: #ff0033;
  }
  .vx-video-badges {
    position: absolute;
    left: 6px;
    bottom: 6px;
    display: flex;
    gap: 4px;
  }
  .vx-video-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
  }
  .vx-video figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
  .vx-video-title {
    color: var(--sl-color-white);
    text-decoration: none;
    font-weight: 600;
  }
  .vx-video-title:hover {
    text-decoration: underline;
  }
  .vx-video-example {
    font-size: var(--sl-text-xs);
  }
  .vx-video-docs {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
